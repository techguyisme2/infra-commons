#!/usr/bin/env python3
"""Pre-push publication gate — this repo is public, so a push IS a
publication. Fail-closed: refuses to push when gitleaks is missing.

1. gitleaks over the full history + working tree (tiny repo; stays cheap).
2. Optional operator-local pattern check: ~/.config/infra-commons/
   forbidden.grep (ERE, one per line, # comments). Lives OUTSIDE the repo
   on purpose — the forbidden identifiers must not appear here, even
   inside a rule.
"""
import shutil
import subprocess
import sys
from pathlib import Path

FAIL = "pre-push: REFUSING to publish"

if shutil.which("gitleaks") is None:
    sys.exit(f"{FAIL}: gitleaks is not installed (brew install gitleaks); "
             "this gate fails closed")
for args in (["gitleaks", "git", "--no-banner", "--redact"],
             ["gitleaks", "dir", "--no-banner", "--redact"]):
    if subprocess.run(args, check=False).returncode != 0:
        sys.exit(f"{FAIL}: gitleaks found leaks ({args[1]} scan)")

patterns = Path.home() / ".config" / "infra-commons" / "forbidden.grep"
if patterns.is_file():
    lines = [ln.strip() for ln in patterns.read_text().splitlines()
             if ln.strip() and not ln.startswith("#")]
    hits = []
    for pat in lines:
        # Tracked content at HEAD plus the working tree, names only.
        for cmd in (["git", "grep", "-l", "-I", "-E", pat, "HEAD"],
                    ["git", "grep", "-l", "-I", "-E", pat]):
            p = subprocess.run(cmd, capture_output=True, text=True, check=False)
            if p.returncode == 0:
                hits.append(pat)
                break
        # And every commit message about to be published (local branches and
        # tags — not remote-tracking refs, which hold what's already out).
        log = subprocess.run(["git", "log", "--branches", "--tags", "-E",
                              f"--grep={pat}", "--format=%h"],
                             capture_output=True, text=True, check=False)
        if log.stdout.strip():
            hits.append(f"{pat} (in a commit message)")
    if hits:
        print(f"{FAIL}: operator-local forbidden patterns matched:",
              file=sys.stderr)
        for h in dict.fromkeys(hits):
            print(f"  - {h}", file=sys.stderr)
        sys.exit(1)
sys.exit(0)
